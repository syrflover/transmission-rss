# The local development environment's settings for both compose files
# (dev/compose.sh passes this file with --env-file). Paths are relative to the
# repository root, where the compose files are.
TRSS_VERSION=local
TRSS_DATA_DIR=./dev/local/data
MEDIA_DIR=./dev/local/media
WATCH_DIR=./dev/local/watch
TRANSMISSION_CONFIG_DIR=./dev/local/transmission-config
# Loopback only: the web has no sign-in, and a local browser reaches it as
# http://localhost:8080.
TRSS_WEB_HOST_IP=127.0.0.1
# The server browser's token. Not a secret here: the browser container
# publishes no port, so only the worker on the compose network reaches it.
TRSS_BROWSER_TOKEN=dev-browser-token
# Added torrents stay stopped (dev/transmission-settings.json). A command that
# starts one still moves at most 1 KiB/s.
SPEED_LIMIT_UP=1
SPEED_LIMIT_DOWN=1
